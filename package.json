{
  "name": "suigen",
  "productName": "Suigen",
  "version": "1.0.0",
  "description": "Desktop application for visualizing quantum particle interactions using Three.js",
  "main": ".vite/build/main.cjs",
  "private": true,
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "electron-forge publish",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "web": "vite --config vite.renderer.config.mts",
    "web:build": "vite build --config vite.renderer.config.mts --outDir ../../out/web --emptyOutDir"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "keywords": [],
  "author": {
    "name": "WinuxNomacs",
    "email": "WinuxNomacs@users.noreply.github.com"
  },
  "license": "MIT",
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-deb": "^8.0.1",
    "@electron-forge/maker-rpm": "^8.0.1",
    "@electron-forge/maker-squirrel": "^8.0.1",
    "@electron-forge/maker-zip": "^8.0.1",
    "@electron-forge/plugin-auto-unpack-natives": "^8.0.1",
    "@electron-forge/plugin-fuses": "^8.0.1",
    "@electron-forge/plugin-vite": "^8.0.1",
    "@electron-forge/shared-types": "^8.0.1",
    "@electron/fuses": "^2.1.3",
    "@eslint/js": "^9.39.5",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/three": "^0.182.0",
    "electron": "^45.2.1",
    "eslint": "^9.39.5",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "globals": "^17.14.0",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "electron-squirrel-startup": "^1.0.1",
    "three": "^0.182.0",
    "zod": "^4.6.7"
  },
  "allowScripts": {
    "electron-winstaller": true
  }
}
